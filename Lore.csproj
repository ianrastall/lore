<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Lore</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Bundle the Windows App SDK runtime so the portable build needs no installed runtime.
         With the SDK-generated entry point (no custom Program.cs) this bootstraps correctly. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release</Configurations>
    <!-- The one place the version is written. The assembly and file versions follow
         from it, and the release scripts read it from here. -->
    <Version>3.4.0</Version>
  </PropertyGroup>

  <!-- The test project (tests\) and the core library (Lore.Core\) live under this
       folder and build separately; keep their files out of the app (the SDK would
       otherwise compile every .cs under this folder). -->
  <ItemGroup>
    <Compile Remove="tests\**;Lore.Core\**" />
    <None Remove="tests\**;Lore.Core\**" />
    <Content Remove="tests\**;Lore.Core\**" />
    <Page Remove="tests\**;Lore.Core\**" />
  </ItemGroup>

  <!-- Everything that needs no window: models, services, view models. The tests
       reference the same assembly. -->
  <ItemGroup>
    <ProjectReference Include="Lore.Core\Lore.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact versions, so a release is built from the same packages it was tested
         with. The packages the calculations rest on (NodaTime, GeoTimeZone, QuestPDF,
         CommunityToolkit.Mvvm) are written once, in Lore.Core\Lore.Core.csproj, and
         reach the app through the reference above. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <!-- Convenience property: root of the bundled Swiss Ephemeris source tree -->
  <PropertyGroup>
    <SweRoot>Data\swisseph-2.10.3bfinal\swisseph-2.10.3bfinal</SweRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lore's own licence (AGPL-3.0) travels with every build -->
    <Content Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>LICENSE.txt</TargetPath>
    </Content>
    <Content Include="Data\celebrities.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- App icon + bundled reference data (cities for custom entry, interpretation corpus) -->
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\AppIcon.ico</TargetPath>
    </Content>
    <!-- Splash-screen artwork; SplashWindow draws the name + version over it at runtime -->
    <Content Include="Assets\splash.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\splash.png</TargetPath>
    </Content>
    <!-- None of these is optional: without its file a reading or the place search is
         simply not there. So none is included "if it exists" - a checkout that lacks one
         fails to build, where it used to build an app with that part quietly missing. -->
    <Content Include="Data\cities.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\hospitals.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\interpretations.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The one list of the files Lore needs at run time: checked against a published
         build by scripts\build-portable.ps1, and by Lore itself when it starts. -->
    <Content Include="required-files.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Corpus for the daily horoscope (transit lines, Moon/Sun/house text) -->
    <Content Include="Data\daily.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Corpus for the synastry reading (aspect lines between two charts, house overlays) -->
    <Content Include="Data\synastry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Corpus for the Davison reading (the relationship's chart: signs, houses, aspects) -->
    <Content Include="Data\davison.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The personality inventory: the IPIP-NEO-120's statements, keys, reference figures and descriptions -->
    <Content Include="Data\inventory.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Corpus for the reading that sets the inventory profile beside the chart -->
    <Content Include="Data\mirror.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The Legend's entries: every glyph, colour and term, explained -->
    <Content Include="Data\legend.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- sweph.dll built by Build-SwephDll.ps1; lives in Native\ but must sit next to
         the exe (the DLL loader searches the app root, not subfolders) -->
    <Content Include="Native\sweph.dll" Condition="Exists('Native\sweph.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>sweph.dll</TargetPath>
    </Content>

    <!--
      Ephemeris data files copied from the bundled source tree.
      Each pair covers a 600-year window:
        _12  = 1200–1800 CE  (needed for da Vinci, Shakespeare, Newton, Mozart…)
        _18  = 1800–2400 CE  (needed for nearly everyone else)
      seleapsec.txt carries leap-second data for UTC↔TT conversion.
    -->
    <Content Include="$(SweRoot)\ephe\sepl_12.se1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\Ephemeris\sepl_12.se1</TargetPath>
    </Content>
    <Content Include="$(SweRoot)\ephe\sepl_18.se1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\Ephemeris\sepl_18.se1</TargetPath>
    </Content>
    <Content Include="$(SweRoot)\ephe\semo_12.se1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\Ephemeris\semo_12.se1</TargetPath>
    </Content>
    <Content Include="$(SweRoot)\ephe\semo_18.se1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\Ephemeris\semo_18.se1</TargetPath>
    </Content>
    <Content Include="$(SweRoot)\ephe\seas_12.se1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\Ephemeris\seas_12.se1</TargetPath>
    </Content>
    <Content Include="$(SweRoot)\ephe\seas_18.se1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\Ephemeris\seas_18.se1</TargetPath>
    </Content>
    <Content Include="$(SweRoot)\seleapsec.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\Ephemeris\seleapsec.txt</TargetPath>
    </Content>
  </ItemGroup>

  <!-- The unpackaged WinUI build emits these after normal content discovery.
       Explicitly include them so the self-contained publish layout keeps its resources. -->
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WinUIResource Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)**/*.xbf" />
      <ResolvedFileToPublish Include="@(_WinUIResource)">
        <RelativePath>%(_WinUIResource.RecursiveDir)%(_WinUIResource.Filename)%(_WinUIResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
