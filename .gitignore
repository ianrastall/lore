# ---- Build output ---------------------------------------------------------
bin/
obj/
/dist/
/artifacts/
*.user
.vs/
TestResults/

# ---- Generated native library (built by build/build-sweph.ps1) ------------
/Native/

# ---- Large re-downloadable raw data (NOT redistributed in the repo) --------
# Full Swiss Ephemeris data set (452 MB) -- download from astro.com if needed.
/content/ephe/
# simplemaps raw world-cities download (5.3 MB CSV + xlsx) -- source for the
# city database; the processed/trimmed data is what gets committed.
/content/simplemaps_worldcities_basicv1.91.4/
# Per-country OpenStreetMap hospital cache written by scripts/build-hospitals.py
# (resume/refetch scratch space; the merged hospitals.json is what gets committed).
/content/.osm_cache/

# ---- Swiss Ephemeris source distribution -----------------------------------
# Keep the C source + Makefile + license (needed to build sweph.dll) and the
# 6 ephemeris files the app actually ships, but drop the bulky extras.
/third_party/swisseph/windows/
/third_party/swisseph/setest/
/third_party/swisseph/doc/
/third_party/swisseph/contrib/
/third_party/swisseph/bin/
# Ignore the swisseph copy of the ephe folder EXCEPT the 6 files we bundle.
/third_party/swisseph/ephe/*
!/third_party/swisseph/ephe/sepl_12.se1
!/third_party/swisseph/ephe/sepl_18.se1
!/third_party/swisseph/ephe/semo_12.se1
!/third_party/swisseph/ephe/semo_18.se1
!/third_party/swisseph/ephe/seas_12.se1
!/third_party/swisseph/ephe/seas_18.se1

# ---- Python bytecode cache -------------------------------------------------
__pycache__/
# Wikidata builder checkpoints (scratch; the CSV/JSON outputs are what matter)
/content/.wikidata_progress.json
scripts/wikidata_progress.json
