<Window
    x:Class="Lore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Lore.Views"
    xmlns:models="using:Lore.Models"
    Title="Lore — Natal Charts">

    <Grid RequestedTheme="Dark" ColumnDefinitions="320,Auto,*">

        <!-- Left: celebrity + my-charts browser -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*"
              Background="{ThemeResource LayerFillColorDefaultBrush}">

            <TextBlock Grid.Row="0"
                       Text="✦ Lore"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="16,16,16,8"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <!-- Add / delete custom charts -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,0,12,8" ColumnSpacing="6">
                <Button Grid.Column="0" HorizontalAlignment="Stretch"
                        Click="AddChart_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Add chart"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                        Visibility="{x:Bind VisIf(ViewModel.SelectedIsCustom), Mode=OneWay}"
                        ToolTipService.ToolTip="Delete this custom chart">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                </Button>
            </Grid>

            <!-- Search -->
            <TextBox Grid.Row="2"
                     x:Name="SearchBox"
                     PlaceholderText="Search…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="12,0,12,8"/>

            <!-- Category filter -->
            <ComboBox Grid.Row="3"
                      x:Name="CategoryCombo"
                      PlaceholderText="All categories"
                      ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Margin="12,0,12,8"/>

            <!-- People list -->
            <ListView Grid.Row="4"
                      x:Name="CelebrityList"
                      ItemsSource="{x:Bind ViewModel.DisplayedCelebrities, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCelebrity, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Celebrity">
                        <StackPanel Padding="4,6">
                            <TextBlock Text="{x:Bind Name}" FontSize="13"/>
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind Category}"/>
                                <Run Text="·"/>
                                <Run Text="{x:Bind BirthDate}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Splitter -->
        <Border Grid.Column="1" Width="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- Right: toolbar + chart/report + status -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <!-- Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <ToggleButton Content="Chart"
                                  IsChecked="{x:Bind Not(ViewModel.ShowReport), Mode=OneWay}"
                                  Click="ShowChart_Click"/>
                    <ToggleButton Content="Report"
                                  IsChecked="{x:Bind ViewModel.ShowReport, Mode=OneWay}"
                                  Click="ShowReport_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <DropDownButton Content="Export">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="PDF — full reading…" Click="ExportPdf_Click"/>
                                <MenuFlyoutItem Text="PNG — chart image…" Click="ExportPng_Click"/>
                                <MenuFlyoutItem Text="JSON — chart data…" Click="ExportJson_Click"/>
                                <MenuFlyoutItem Text="XML — chart data…" Click="ExportXml_Click"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Content="Legend">
                        <Button.Flyout>
                            <Flyout>
                                <views:LegendView/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body: chart or report -->
            <Grid Grid.Row="1">
                <views:ChartView Grid.Row="0"
                                 x:Name="ChartViewControl"
                                 ViewModel="{x:Bind ViewModel.ChartVM}"
                                 RequestedTheme="Dark"
                                 Visibility="{x:Bind VisIfNot(ViewModel.ShowReport), Mode=OneWay}"/>
                <views:ReportView x:Name="ReportViewControl"
                                  ViewModel="{x:Bind ViewModel.ChartVM}"
                                  RequestedTheme="Dark"
                                  Visibility="{x:Bind VisIf(ViewModel.ShowReport), Mode=OneWay}"/>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="12,4"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <ProgressRing Grid.Column="1"
                                  IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="16" Height="16"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
