<Window
    x:Class="Lore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Lore.Views"
    xmlns:models="using:Lore.Models"
    Title="Lore — Natal Charts">

    <Grid RequestedTheme="Dark" ColumnDefinitions="320,Auto,*">

        <Grid.Resources>
            <views:HexBrushConverter x:Key="HexBrush"/>
        </Grid.Resources>


        <!-- Left: celebrity + my-charts browser -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*"
              Background="{ThemeResource LayerFillColorDefaultBrush}">

            <TextBlock Grid.Row="0"
                       Text="✦ Lore"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="16,16,16,8"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <!-- Add / edit / delete custom charts -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="12,0,12,8" ColumnSpacing="6">
                <Button Grid.Column="0" HorizontalAlignment="Stretch"
                        Click="AddChart_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Add chart"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Click="EditChart_Click"
                        Visibility="{x:Bind VisIf(ViewModel.SelectedIsCustom), Mode=OneWay}"
                        AutomationProperties.Name="Edit this chart"
                        ToolTipService.ToolTip="Edit this chart">
                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                </Button>
                <Button Grid.Column="2"
                        Click="DeleteChart_Click"
                        Visibility="{x:Bind VisIf(ViewModel.SelectedIsCustom), Mode=OneWay}"
                        AutomationProperties.Name="Delete this chart"
                        ToolTipService.ToolTip="Delete this chart">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                </Button>
            </Grid>

            <!-- Search -->
            <TextBox Grid.Row="2"
                     x:Name="SearchBox"
                     PlaceholderText="Search…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="12,0,12,8"/>

            <!-- Category filter -->
            <ComboBox Grid.Row="3"
                      x:Name="CategoryCombo"
                      PlaceholderText="All categories"
                      ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Margin="12,0,12,8"/>

            <!-- People list -->
            <ListView Grid.Row="4"
                      x:Name="CelebrityList"
                      ItemsSource="{x:Bind ViewModel.DisplayedCelebrities, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCelebrity, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Celebrity">
                        <!-- Whole-row notability wash: green (Extraordinary) / red
                             (Alarming), transparent for Ordinary. -->
                        <Grid Padding="10,6" CornerRadius="4"
                              Background="{Binding VerdictColorHex, Converter={StaticResource HexBrush}}"
                              ToolTipService.ToolTip="{x:Bind VerdictLabel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" FontSize="13"/>
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind Category}"/>
                                    <Run Text="·"/>
                                    <Run Text="{x:Bind BirthDate}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Splitter -->
        <Border Grid.Column="1" Width="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- Right: toolbar + chart/report + status -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <!-- Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <!-- View switch. IsChecked is set from code (SyncViewToggles) so a click on
                     the already-selected button can't leave it visually unchecked. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <ToggleButton x:Name="ChartToggle" Content="Chart" IsChecked="True"
                                  Click="ShowChart_Click"/>
                    <ToggleButton x:Name="ReportToggle" Content="Report"
                                  Click="ShowReport_Click"/>
                    <ToggleButton x:Name="WorksheetToggle" Content="Worksheet"
                                  Click="ShowWorksheet_Click"
                                  ToolTipService.ToolTip="The numbers behind the chart, and how they were calculated"/>
                    <ToggleButton x:Name="DailyToggle" Content="Daily"
                                  Click="ShowDaily_Click"
                                  ToolTipService.ToolTip="Daily horoscope from today's transits"/>
                    <ToggleButton x:Name="ForecastToggle" Content="Forecast"
                                  Click="ShowForecast_Click"
                                  ToolTipService.ToolTip="The transits coming up over the next weeks and months"/>
                    <ToggleButton x:Name="SynastryToggle" Content="Synastry"
                                  Click="ShowSynastry_Click"
                                  ToolTipService.ToolTip="Compare this chart with another person's"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <DropDownButton Content="Export">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="PDF — full reading…" Click="ExportPdf_Click"/>
                                <MenuFlyoutItem Text="PNG — chart image…" Click="ExportPng_Click"/>
                                <MenuFlyoutItem Text="JSON — chart data…" Click="ExportJson_Click"/>
                                <MenuFlyoutItem Text="XML — chart data…" Click="ExportXml_Click"/>
                                <MenuFlyoutItem Text="Text — worksheet…" Click="ExportWorksheet_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="PDF — daily horoscope…" Click="ExportDailyPdf_Click"/>
                                <MenuFlyoutItem Text="Text — daily horoscope…" Click="ExportDailyText_Click"/>
                                <MenuFlyoutItem Text="Text — forecast…" Click="ExportForecastText_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="PDF — synastry reading…" Click="ExportSynastryPdf_Click"/>
                                <MenuFlyoutItem Text="PNG — synastry bi-wheel…" Click="ExportSynastryPng_Click"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton Content="Settings"
                                    ToolTipService.ToolTip="How charts are calculated">
                        <DropDownButton.Flyout>
                            <Flyout>
                                <StackPanel Spacing="12" Width="280">
                                    <ComboBox x:Name="HouseSystemCombo" Header="House system"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="Settings_Changed">
                                        <ComboBoxItem Content="Placidus"/>
                                        <ComboBoxItem Content="Whole Sign"/>
                                        <ComboBoxItem Content="Equal"/>
                                        <ComboBoxItem Content="Koch"/>
                                    </ComboBox>
                                    <ComboBox x:Name="NodeTypeCombo" Header="North Node"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="Settings_Changed">
                                        <ComboBoxItem Content="Mean node"/>
                                        <ComboBoxItem Content="True node"/>
                                    </ComboBox>
                                    <ComboBox x:Name="OrbPresetCombo" Header="Aspect orbs (birth chart)"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OrbPreset_Changed">
                                        <ComboBoxItem Content="Standard — 8°, sextile 6°"/>
                                        <ComboBoxItem Content="Tight — 6°, sextile 4°, Sun and Moon +2°"/>
                                        <ComboBoxItem Content="Wide — 10°, sextile 6°"/>
                                        <ComboBoxItem Content="Custom"/>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="6"
                                          RowDefinitions="Auto,Auto,Auto">
                                        <NumberBox x:Name="OrbConjunctionBox" Grid.Row="0" Grid.Column="0" Header="☌ Conjunction"
                                                   Minimum="0" Maximum="15" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Orb_Changed"/>
                                        <NumberBox x:Name="OrbOppositionBox" Grid.Row="0" Grid.Column="1" Header="☍ Opposition"
                                                   Minimum="0" Maximum="15" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Orb_Changed"/>
                                        <NumberBox x:Name="OrbSquareBox" Grid.Row="1" Grid.Column="0" Header="□ Square"
                                                   Minimum="0" Maximum="15" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Orb_Changed"/>
                                        <NumberBox x:Name="OrbTrineBox" Grid.Row="1" Grid.Column="1" Header="△ Trine"
                                                   Minimum="0" Maximum="15" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Orb_Changed"/>
                                        <NumberBox x:Name="OrbSextileBox" Grid.Row="2" Grid.Column="0" Header="⚹ Sextile"
                                                   Minimum="0" Maximum="15" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Orb_Changed"/>
                                        <NumberBox x:Name="OrbLuminaryBox" Grid.Row="2" Grid.Column="1" Header="Sun / Moon extra"
                                                   Minimum="0" Maximum="15" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Orb_Changed"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <CheckBox x:Name="MinorAspectsCheck" Grid.Column="0" VerticalAlignment="Bottom"
                                                  Content="Minor aspects"
                                                  ToolTipService.ToolTip="Also find the semi-sextile (30°), semi-square (45°), sesquiquadrate (135°) and quincunx (150°), and the Yod pattern"
                                                  Checked="Minor_Changed" Unchecked="Minor_Changed"/>
                                        <NumberBox x:Name="OrbMinorBox" Grid.Column="1" Header="Minor orb"
                                                   Minimum="0" Maximum="15" SmallChange="0.5" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Orb_Changed"/>
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="House system and node apply to every chart, the daily horoscope and synastry. The orbs apply to aspects within a birth chart; synastry (6°) and the daily horoscope (1°) keep their own. Each chart shows which settings were used."/>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Content="Legend" Click="ShowLegend_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body: chart, report, daily, synastry, or the full-page legend -->
            <Grid Grid.Row="1">
                <views:ChartView Grid.Row="0"
                                 x:Name="ChartViewControl"
                                 ViewModel="{x:Bind ViewModel.ChartVM}"
                                 RequestedTheme="Dark"
                                 Visibility="{x:Bind VisChartBody(ViewModel.ShowReport, ViewModel.ShowWorksheet, ViewModel.ShowDaily, ViewModel.ShowForecast, ViewModel.ShowSynastry, ViewModel.ShowLegend), Mode=OneWay}"/>
                <views:ReportView x:Name="ReportViewControl"
                                  ViewModel="{x:Bind ViewModel.ChartVM}"
                                  RequestedTheme="Dark"
                                  Visibility="{x:Bind VisReportBody(ViewModel.ShowReport, ViewModel.ShowLegend), Mode=OneWay}"/>
                <views:WorksheetView x:Name="WorksheetViewControl"
                                     ViewModel="{x:Bind ViewModel.ChartVM}"
                                     RequestedTheme="Dark"
                                     Visibility="{x:Bind VisReportBody(ViewModel.ShowWorksheet, ViewModel.ShowLegend), Mode=OneWay}"/>
                <views:DailyView x:Name="DailyViewControl"
                                 ViewModel="{x:Bind ViewModel.DailyVM}"
                                 RequestedTheme="Dark"
                                 Visibility="{x:Bind VisReportBody(ViewModel.ShowDaily, ViewModel.ShowLegend), Mode=OneWay}"/>
                <views:ForecastView x:Name="ForecastViewControl"
                                    ViewModel="{x:Bind ViewModel.ForecastVM}"
                                    RequestedTheme="Dark"
                                    Visibility="{x:Bind VisReportBody(ViewModel.ShowForecast, ViewModel.ShowLegend), Mode=OneWay}"/>
                <views:SynastryView x:Name="SynastryViewControl"
                                    ViewModel="{x:Bind ViewModel.SynastryVM}"
                                    RequestedTheme="Dark"
                                    Visibility="{x:Bind VisReportBody(ViewModel.ShowSynastry, ViewModel.ShowLegend), Mode=OneWay}"/>
                <views:LegendView x:Name="LegendViewControl"
                                  RequestedTheme="Dark"
                                  CloseRequested="Legend_CloseRequested"
                                  Visibility="{x:Bind VisIf(ViewModel.ShowLegend), Mode=OneWay}"/>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="12,4"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <ProgressRing Grid.Column="1"
                                  IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="16" Height="16"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
