<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.DailyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Generated from the day's transits to this chart — a prompt for reflection, not a prediction."
                           Opacity="0.7" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Date navigation -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Command="{x:Bind ViewModel.PreviousDayCommand}"
                        AutomationProperties.Name="Previous day"
                        ToolTipService.ToolTip="Previous day">
                    <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                </Button>
                <CalendarDatePicker Date="{x:Bind ViewModel.PickerDate, Mode=TwoWay}"
                                    DateFormat="{}{dayofweek.full} {day.integer} {month.full} {year.full}"
                                    MinWidth="230"/>
                <Button Command="{x:Bind ViewModel.NextDayCommand}"
                        AutomationProperties.Name="Next day"
                        ToolTipService.ToolTip="Next day">
                    <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                </Button>
                <Button Content="Today"
                        Command="{x:Bind ViewModel.TodayCommand}"
                        IsEnabled="{x:Bind Not(ViewModel.IsToday), Mode=OneWay}"/>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="16" Height="16" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                       Foreground="#E5534B" TextWrapping="Wrap"
                       Visibility="{x:Bind HasText(ViewModel.ErrorText), Mode=OneWay}"/>

            <!-- Day tone pill -->
            <Border Padding="9,3" CornerRadius="10" HorizontalAlignment="Left"
                    Background="{x:Bind ViewModel.ToneBrush, Mode=OneWay}"
                    Visibility="{x:Bind HasText(ViewModel.ToneText), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ToneText, Mode=OneWay}"
                           FontSize="12" FontWeight="SemiBold" Foreground="#111318"/>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DailySection">
                        <StackPanel Spacing="10" Margin="0,0,0,14">
                            <TextBlock Text="{x:Bind Heading}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DailyItem">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                       FontSize="15" TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasTitle}"/>
                                            <TextBlock Text="{x:Bind Meta}" FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,1,0,0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasMeta}"/>
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                                       LineHeight="20" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The calculation trail behind the reading -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Visibility="{x:Bind HasText(ViewModel.TraceHeader), Mode=OneWay}">
                <Expander.Header>
                    <TextBlock Text="{x:Bind ViewModel.TraceHeader, Mode=OneWay}" TextWrapping="Wrap"/>
                </Expander.Header>
                <StackPanel Spacing="4">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"
                               Text="Each line is a moving planet in aspect to a point in this birth chart. The reading uses the closest and most significant few: up to three from the faster planets (Sun to Mars) and three from the slower ones."/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Trace, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
