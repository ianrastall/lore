<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models"
    xmlns:vm="using:Lore.ViewModels">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: whose, and what this is -->
        <StackPanel Grid.Row="0" Padding="24,16,24,8">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="A standard personality questionnaire and the profile it gives. It is not astrology: nothing here is taken from the chart."
                       Opacity="0.7" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Nobody selected -->
        <TextBlock Grid.Row="1" Margin="24,8"
                   Text="Select one of your own charts from the list to answer the questionnaire for that person."
                   TextWrapping="Wrap"
                   Visibility="{x:Bind VisIf(ViewModel.IsNoChart), Mode=OneWay}"/>

        <!-- A bundled figure -->
        <TextBlock Grid.Row="1" Margin="24,8" MaxWidth="720" HorizontalAlignment="Left"
                   Text="{x:Bind ViewModel.NotOfferedText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind VisIf(ViewModel.IsNotOffered), Mode=OneWay}"/>

        <!-- The questionnaire's own file is missing -->
        <TextBlock Grid.Row="1" Margin="24,8" MaxWidth="720" HorizontalAlignment="Left"
                   Foreground="#E5534B"
                   Text="The questionnaire could not be read (Data\inventory.json is missing or damaged). Reinstalling Lore will put it back."
                   TextWrapping="Wrap"
                   Visibility="{x:Bind VisIf(ViewModel.IsUnavailable), Mode=OneWay}"/>

        <!-- Before beginning -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind VisIf(ViewModel.IsIntroduction), Mode=OneWay}">
            <StackPanel Spacing="12" Padding="24,8,24,24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind ViewModel.AboutText, Mode=OneWay}" TextWrapping="Wrap" LineHeight="20"/>
                <TextBlock Text="{x:Bind ViewModel.AstrologyText}" TextWrapping="Wrap" LineHeight="20"/>
                <TextBlock Text="{x:Bind ViewModel.PrivacyText}" TextWrapping="Wrap" LineHeight="20"/>
                <TextBlock Text="It should be answered by the person the chart belongs to, alone and without hurrying. There are no right answers."
                           TextWrapping="Wrap" LineHeight="20"/>
                <Button x:Name="BeginButton" Content="Begin" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.BeginCommand}"
                        AutomationProperties.Name="Begin the questionnaire"/>
                <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Answering: a page of statements at a time -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto"
              Visibility="{x:Bind VisIf(ViewModel.IsAsking), Mode=OneWay}">
            <StackPanel Grid.Row="0" Padding="24,0,24,8" Spacing="6" MaxWidth="980" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind ViewModel.Prompt, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" TextWrapping="Wrap" Foreground="#E0A030"
                           Visibility="{x:Bind VisIf(ViewModel.HasNotice), Mode=OneWay}"/>
            </StackPanel>

            <ScrollViewer x:Name="QuestionScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,8">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Questions, Mode=OneWay}" MaxWidth="980" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InventoryQuestion">
                            <Grid ColumnDefinitions="44,*" Margin="0,0,0,14">
                                <TextBlock Grid.Column="0" Text="{x:Bind NumberText}" FontSize="15"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Text}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <!-- Five choices in a row, least to most accurate -->
                                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,2,0,0"
                                                AutomationProperties.Name="{x:Bind Text}">
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice1}" MinWidth="0"
                                                     IsChecked="{x:Bind Is1, Mode=TwoWay}"/>
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice2}" MinWidth="0"
                                                     IsChecked="{x:Bind Is2, Mode=TwoWay}"/>
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice3}" MinWidth="0"
                                                     IsChecked="{x:Bind Is3, Mode=TwoWay}"/>
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice4}" MinWidth="0"
                                                     IsChecked="{x:Bind Is4, Mode=TwoWay}"/>
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice5}" MinWidth="0"
                                                     IsChecked="{x:Bind Is5, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="24,10" BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Back" Command="{x:Bind ViewModel.PreviousCommand}"
                            IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                            AutomationProperties.Name="The ten statements before"/>
                    <Button Content="Next" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.NextCommand}"
                            Visibility="{x:Bind VisIf(ViewModel.CanGoOn), Mode=OneWay}"
                            AutomationProperties.Name="The next ten statements"/>
                    <Button Content="Finish and see the profile" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.FinishCommand}"
                            Visibility="{x:Bind VisIf(ViewModel.IsLastPage), Mode=OneWay}"/>
                    <ProgressBar Width="220" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                 Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                 AutomationProperties.Name="How much of the questionnaire is answered"/>
                    <TextBlock VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind ViewModel.PageText, Mode=OneWay}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"/>
                    </TextBlock>
                    <HyperlinkButton Content="Stop and discard this sitting" Click="Abandon_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- With a profile: the profile itself, or the reading that sets it beside the chart -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Visibility="{x:Bind VisIf(ViewModel.IsProfile), Mode=OneWay}">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="24,0,24,6"
                    Visibility="{x:Bind VisIf(ViewModel.HasReading), Mode=OneWay}">
            <RadioButton Content="Profile" GroupName="InventoryMode"
                         AutomationProperties.Name="Show the personality profile"
                         IsChecked="{x:Bind Not(ViewModel.ShowReading), Mode=OneWay}"
                         Checked="ProfileRadio_Checked"/>
            <RadioButton Content="Chart and answers" GroupName="InventoryMode"
                         AutomationProperties.Name="Show the reading that sets the profile beside the chart"
                         ToolTipService.ToolTip="How each planet of the chart is being lived, by the answers"
                         IsChecked="{x:Bind ViewModel.ShowReading, Mode=OneWay}"
                         Checked="ReadingRadio_Checked"/>
            <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <CheckBox Content="Let the answers shape the Report, Daily and Forecast"
                      IsChecked="{x:Bind ViewModel.ShapeReadings, Mode=TwoWay}"
                      ToolTipService.ToolTip="Adds sentences to the Report (its Overview, planets, aspects and balance) and to transits in the Daily and Forecast readings, saying how the answers describe what is spoken of. Each begins “By … answers”. The chart itself is never changed."/>
        </StackPanel>

        <!-- The reading: chart and answers side by side -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind VisIf(ViewModel.ReadingShown), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.ReadingSections, Mode=OneWay}"
                          Padding="24,0,24,24" MaxWidth="820" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DailySection">
                        <StackPanel Spacing="10" Margin="0,6,0,14">
                            <TextBlock Text="{x:Bind Heading}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DailyItem">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                       FontSize="15" TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasTitle}"/>
                                            <TextBlock Text="{x:Bind Meta}" FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,1,0,0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasMeta}"/>
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                                       LineHeight="20" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- The profile -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind VisIf(ViewModel.ProfileShown), Mode=OneWay}">
            <StackPanel Spacing="14" Padding="24,0,24,24" MaxWidth="1040" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind ViewModel.TakenText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.Caution}" TextWrapping="Wrap" LineHeight="20" MaxWidth="820" HorizontalAlignment="Left"/>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Domains, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DomainScore">
                            <StackPanel Spacing="6" Margin="0,8,0,14">
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14">
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <Border Grid.Column="1" Padding="9,2" CornerRadius="10" VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind BandLabel}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind ScoreText}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{x:Bind PercentileText}"/>
                                    </TextBlock>
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Percentile}" Width="420" HorizontalAlignment="Left"
                                             AutomationProperties.Name="{x:Bind Name}"/>
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" LineHeight="20" MaxWidth="820" HorizontalAlignment="Left"/>
                                <TextBlock Text="{x:Bind About}" TextWrapping="Wrap" FontSize="12" MaxWidth="820" HorizontalAlignment="Left"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <ItemsControl ItemsSource="{x:Bind Facets}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FacetScore">
                                            <Grid ColumnDefinitions="170,84,110,*" ColumnSpacing="12" Padding="0,5"
                                                  ToolTipService.ToolTip="{x:Bind Measures}">
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind BandLabel}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{x:Bind Percentile}"
                                                             VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}"/>
                                                <TextBlock Grid.Column="3" Text="{x:Bind Text}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock TextWrapping="Wrap" FontSize="12" MaxWidth="820" HorizontalAlignment="Left"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Low, typical and high are set against the reference group: typical is within one standard deviation of its average, where about two people in three fall; low and high are beyond that, about one in six each way. Each bar shows roughly what share of that group scored lower. A facet rests on four statements, so read its bar as a rough placing and not as a measurement; the mood of the day moves some of them."/>
                <TextBlock Text="{x:Bind ViewModel.NormsText, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"/>
                <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <Button Content="Answer it again" Command="{x:Bind ViewModel.TakeAgainCommand}"
                            ToolTipService.ToolTip="A new sitting; this one is kept"/>
                    <Button Content="Delete the answers…" Click="Delete_Click"
                            ToolTipService.ToolTip="Removes every answer saved for this person"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
