<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.ForecastView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="The transits coming up for this chart, in the order they peak — a prompt for reflection, not a prediction. The Moon's quick contacts are left to the Daily view."
                           Opacity="0.7" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- From when, and for how long -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CalendarDatePicker Date="{x:Bind ViewModel.PickerDate, Mode=TwoWay}"
                                    DateFormat="{}{day.integer} {month.full} {year.full}"
                                    MinWidth="190" VerticalAlignment="Center"/>
                <ComboBox SelectedIndex="{x:Bind ViewModel.SpanIndex, Mode=TwoWay}"
                          MinWidth="150" VerticalAlignment="Center">
                    <ComboBoxItem Content="One month"/>
                    <ComboBoxItem Content="Three months"/>
                    <ComboBoxItem Content="Six months"/>
                    <ComboBoxItem Content="One year"/>
                </ComboBox>
                <Button Content="From today" Command="{x:Bind ViewModel.FromTodayCommand}" VerticalAlignment="Center"/>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox Content="Include the Sun, Mercury, Venus and Mars"
                      IsChecked="{x:Bind ViewModel.IncludeFast, Mode=TwoWay}" Margin="0,-8,0,0"
                      ToolTipService.ToolTip="Untick to list only Jupiter and beyond: fewer transits, each lasting weeks"/>

            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                       Foreground="#E5534B" TextWrapping="Wrap"
                       Visibility="{x:Bind HasText(ViewModel.ErrorText), Mode=OneWay}"/>

            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind HasText(ViewModel.Summary), Mode=OneWay}"/>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DailySection">
                        <StackPanel Spacing="10" Margin="0,0,0,14">
                            <TextBlock Text="{x:Bind Heading}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DailyItem">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                       FontSize="15" TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasTitle}"/>
                                            <TextBlock Text="{x:Bind Meta}" FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,1,0,0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasMeta}"/>
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                                       LineHeight="20" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
