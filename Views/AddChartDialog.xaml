<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Lore.Views.AddChartDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add a chart"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="10" Width="360">

            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="e.g. Jane Doe"/>

            <DatePicker x:Name="DateField" Header="Birth date"/>

            <StackPanel Spacing="4">
                <TimePicker x:Name="TimeField" Header="Birth time" ClockIdentifier="24HourClock"/>
                <CheckBox x:Name="TimeUnknownCheck" Content="Birth time unknown (use noon)"
                          Checked="TimeUnknown_Changed" Unchecked="TimeUnknown_Changed"/>
            </StackPanel>

            <AutoSuggestBox x:Name="CityBox"
                            Header="Birthplace (search to autofill coordinates)"
                            PlaceholderText="Start typing a city…"
                            TextChanged="CityBox_TextChanged"
                            SuggestionChosen="CityBox_SuggestionChosen"
                            DisplayMemberPath="Display"
                            TextMemberPath="Display"
                            QueryIcon="Find"/>

            <TextBox x:Name="PlaceBox" Header="Birthplace label"
                     PlaceholderText="e.g. Boston, USA"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <NumberBox x:Name="LatBox" Grid.Column="0" Header="Latitude"
                           SpinButtonPlacementMode="Inline" SmallChange="0.01" LargeChange="1"/>
                <NumberBox x:Name="LonBox" Grid.Column="1" Header="Longitude"
                           SpinButtonPlacementMode="Inline" SmallChange="0.01" LargeChange="1"/>
            </Grid>

            <NumberBox x:Name="UtcBox" Header="UTC offset (hours, standard time — not DST)"
                       SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1"
                       Minimum="-12" Maximum="14"/>

            <TextBox x:Name="NoteBox" Header="Note (optional)"
                     PlaceholderText="anything you'd like to remember"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
