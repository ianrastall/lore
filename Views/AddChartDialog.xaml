<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Lore.Views.AddChartDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add a chart"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="10" Width="360">

            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="e.g. Jane Doe"/>

            <StackPanel Spacing="4">
                <DatePicker x:Name="DateField" Header="Birth date"/>
                <!-- Shown only for years in which some country was still on the Julian calendar -->
                <CheckBox x:Name="JulianCheck" Visibility="Collapsed"
                          Content="This is an Old Style (Julian calendar) date"
                          Checked="Julian_Changed" Unchecked="Julian_Changed"/>
                <TextBlock x:Name="JulianText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TimePicker x:Name="TimeField" Header="Birth time" ClockIdentifier="24HourClock"/>
                <CheckBox x:Name="TimeUnknownCheck" Content="Birth time unknown (use noon)"
                          Checked="TimeUnknown_Changed" Unchecked="TimeUnknown_Changed"/>
                <NumberBox x:Name="UncertaintyBox"
                           Header="The time could be off by up to (minutes either way; 0 if exact)"
                           SpinButtonPlacementMode="Inline" SmallChange="5" LargeChange="15"
                           Minimum="0" Maximum="180" Value="0"/>
            </StackPanel>

            <ComboBox x:Name="RatingCombo" HorizontalAlignment="Stretch"
                      Header="Where the birth time comes from (Rodden rating)"/>
            <TextBox x:Name="SourceBox" Header="Source (optional)"
                     PlaceholderText="e.g. birth certificate; mother's memory"/>

            <AutoSuggestBox x:Name="HospitalBox"
                            Header="Birthplace hospital (search to autofill precise coordinates)"
                            PlaceholderText="Start typing a hospital…"
                            TextChanged="HospitalBox_TextChanged"
                            SuggestionChosen="HospitalBox_SuggestionChosen"
                            DisplayMemberPath="Display"
                            TextMemberPath="Display"
                            QueryIcon="Find"/>

            <AutoSuggestBox x:Name="CityBox"
                            Header="Or search a city (if the hospital isn't listed)"
                            PlaceholderText="Start typing a city…"
                            TextChanged="CityBox_TextChanged"
                            SuggestionChosen="CityBox_SuggestionChosen"
                            DisplayMemberPath="Display"
                            TextMemberPath="Display"
                            QueryIcon="Find"/>

            <TextBox x:Name="PlaceBox" Header="Birthplace label"
                     PlaceholderText="e.g. Boston, USA"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <NumberBox x:Name="LatBox" Grid.Column="0" Header="Latitude" ValueChanged="Place_ValueChanged"
                           SpinButtonPlacementMode="Inline" SmallChange="0.01" LargeChange="1"/>
                <NumberBox x:Name="LonBox" Grid.Column="1" Header="Longitude" ValueChanged="Place_ValueChanged"
                           SpinButtonPlacementMode="Inline" SmallChange="0.01" LargeChange="1"/>
            </Grid>

            <TextBlock x:Name="ResolvedOffsetText"
                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                       TextWrapping="Wrap" FontSize="12"
                       Text="Pick a birthplace to resolve its time zone."/>

            <StackPanel Spacing="4">
                <CheckBox x:Name="OffsetFixedCheck" Content="Set the UTC offset myself"
                          Checked="OffsetFixed_Changed" Unchecked="OffsetFixed_Changed"/>
                <NumberBox x:Name="UtcBox" Header="UTC offset in hours (east of Greenwich is positive)"
                           SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1"
                           Minimum="-14" Maximum="14" IsEnabled="False"/>
            </StackPanel>

            <TextBox x:Name="NoteBox" Header="Note (optional)"
                     PlaceholderText="anything you'd like to remember"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
