<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.LegendView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lore.Views">

    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedItems" IsSourceGrouped="True"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- Header: back + title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14"
                    Padding="16,12" VerticalAlignment="Center">
            <Button Click="Back_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    <TextBlock Text="Back"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Legend &amp; Reference" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Body: item list  |  explanation -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*">

            <ListView x:Name="ItemsList" Grid.Column="0"
                      ItemsSource="{x:Bind GroupedItems.View, Mode=OneWay}"
                      SelectionChanged="ItemsList_SelectionChanged"
                      Padding="8,0,8,12"
                      BorderThickness="0,0,1,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,2"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LegendItem">
                        <Grid ColumnDefinitions="32,*" Padding="0,4">
                            <TextBlock Grid.Column="0" Text="{x:Bind Symbol}"
                                       FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" FontSize="13"/>
                                <TextBlock Text="{x:Bind Short}" FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Key}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Margin="0,12,0,2"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <ScrollViewer Grid.Column="1" Padding="32,24" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Border x:Name="DetailSwatch" Width="6" CornerRadius="3"
                                Visibility="Collapsed"/>
                        <TextBlock x:Name="DetailSymbol" FontSize="52" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DetailName" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailGroup" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="DetailContent" Spacing="12"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
