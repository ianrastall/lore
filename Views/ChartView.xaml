<UserControl
    x:Class="Lore.Views.ChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:vm="using:Lore.ViewModels"
    xmlns:models="using:Lore.Models">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="16,12">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.SubTitle, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12" Margin="0,2,0,0"/>
            <TextBlock Text="{x:Bind ViewModel.BigThreeText, Mode=OneWay}"
                       FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.AnglesText, Mode=OneWay}"
                       FontSize="11" Margin="0,2,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Border Margin="0,6,0,0" Padding="9,3" CornerRadius="10"
                    HorizontalAlignment="Left"
                    Background="{x:Bind ViewModel.ScoreBrush, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}"
                           FontSize="12" FontWeight="SemiBold" Foreground="#111318"/>
            </Border>
        </StackPanel>

        <!-- Chart + side panel -->
        <Grid Grid.Row="1" ColumnDefinitions="*,240">

            <!-- Win2D chart canvas -->
            <canvas:CanvasControl x:Name="ChartCanvas"
                                  Grid.Column="0"
                                  Draw="ChartCanvas_Draw"
                                  SizeChanged="ChartCanvas_SizeChanged"
                                  Margin="8"/>

            <!-- Planets & aspects panel -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,*" Padding="0,8,8,8">

                <TextBlock Grid.Row="0" Text="Planets"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="0,0,0,4"/>

                <ListView Grid.Row="1"
                          x:Name="PlanetsList"
                          SelectionChanged="PlanetsList_SelectionChanged"
                          ItemsSource="{x:Bind ViewModel.Chart.Planets, Mode=OneWay, FallbackValue={x:Null}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlanetPosition">
                            <Grid ColumnDefinitions="28,*" Padding="0,2">
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind PlanetSymbol}"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind PlanetName}" FontSize="12"/>
                                    <TextBlock Text="{x:Bind FormatPosition()}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="2" Text="Aspects"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="0,8,0,4"/>

                <ListView Grid.Row="3"
                          ItemsSource="{x:Bind ViewModel.Chart.Aspects, Mode=OneWay, FallbackValue={x:Null}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Aspect">
                            <TextBlock Text="{x:Bind Description}"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       Padding="0,2"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </Grid>

        <!-- Status bar placeholder -->
        <Border Grid.Row="2" Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

    </Grid>
</UserControl>
