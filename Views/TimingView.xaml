<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.TimingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:models="using:Lore.Models">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: whose, and as of when -->
        <StackPanel Grid.Row="0" Spacing="10" Padding="24,16,24,8">
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Two ways of carrying the birth chart forward to a date: the solar return for that year, and the chart progressed a day for each year of life. The positions are given as they are; nothing here is interpreted."
                           Opacity="0.7" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Command="{x:Bind ViewModel.PreviousYearCommand}"
                        AutomationProperties.Name="A year earlier" ToolTipService.ToolTip="A year earlier">
                    <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                </Button>
                <CalendarDatePicker Date="{x:Bind ViewModel.PickerDate, Mode=TwoWay}"
                                    DateFormat="{}{day.integer} {month.full} {year.full}"
                                    MinWidth="190"/>
                <Button Command="{x:Bind ViewModel.NextYearCommand}"
                        AutomationProperties.Name="A year later" ToolTipService.ToolTip="A year later">
                    <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                </Button>
                <Button Content="Today" Command="{x:Bind ViewModel.TodayCommand}"/>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="16" Height="16" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- Where the solar return is cast for: the birthplace unless a city is chosen -->
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind VisIf(ViewModel.CanChoosePlace), Mode=OneWay}">
                <AutoSuggestBox x:Name="PlaceBox"
                                Width="300"
                                PlaceholderText="Cast the return for another place…"
                                QueryIcon="Find"
                                DisplayMemberPath="Display"
                                TextMemberPath="Display"
                                TextChanged="PlaceBox_TextChanged"
                                QuerySubmitted="PlaceBox_QuerySubmitted"
                                AutomationProperties.Name="Place to cast the solar return for"
                                ToolTipService.ToolTip="Many astrologers cast the return for where the person was living that year. The moment is the same; the Ascendant and houses change with the place."/>
                <TextBlock Text="{x:Bind ViewModel.PlaceText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="Use the birthplace"
                        Command="{x:Bind ViewModel.UseBirthplaceCommand}"
                        Visibility="{x:Bind VisIf(ViewModel.HasPlace), Mode=OneWay}"/>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                       Foreground="#E5534B" TextWrapping="Wrap"
                       Visibility="{x:Bind HasText(ViewModel.ErrorText), Mode=OneWay}"/>
        </StackPanel>

        <!-- Text on the left, the return chart's wheel on the right -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*">
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,0,16,24">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}" MaxWidth="720" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DailySection">
                            <StackPanel Spacing="10" Margin="0,0,0,14">
                                <TextBlock Text="{x:Bind Heading}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DailyItem">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                           FontSize="15" TextWrapping="Wrap"
                                                           Visibility="{x:Bind HasTitle}"/>
                                                <TextBlock Text="{x:Bind Meta}" FontSize="12" TextWrapping="Wrap"
                                                           Margin="0,1,0,0"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind HasMeta}"/>
                                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                                           LineHeight="20" Margin="0,4,0,0" IsTextSelectionEnabled="True"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="0,0,16,16"
                  Visibility="{x:Bind VisIf(ViewModel.HasReturnChart), Mode=OneWay}">
                <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.WheelCaption, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="8,0,0,4"/>
                <canvas:CanvasControl x:Name="WheelCanvas" Grid.Row="1"
                                      Draw="WheelCanvas_Draw" SizeChanged="WheelCanvas_SizeChanged"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
