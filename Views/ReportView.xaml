<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.ReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="A generated reading — a starting point, not the last word."
                       Opacity="0.7" FontSize="12" Margin="0,-10,0,0"/>

            <ItemsControl ItemsSource="{x:Bind ViewModel.ReportSections, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ReportSection">
                        <StackPanel Spacing="6" Margin="0,0,0,10">
                            <TextBlock Text="{x:Bind Heading}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind Paragraphs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap"
                                                   Margin="0,0,0,6" LineHeight="20"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
