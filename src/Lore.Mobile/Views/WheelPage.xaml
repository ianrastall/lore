<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lore.ViewModels;assembly=Lore.Core"
             xmlns:views="clr-namespace:Lore.Mobile.Views"
             x:Class="Lore.Mobile.Views.WheelPage"
             x:DataType="vm:ChartViewModel"
             Title="Wheel">
    <Grid>
        <Label Text="Choose someone in Charts to see their chart." Style="{StaticResource Secondary}"
               HorizontalOptions="Center" VerticalOptions="Center" Padding="24"
               IsVisible="{Binding HasChart, Converter={StaticResource Not}}" />
        <ScrollView IsVisible="{Binding HasChart}">
            <VerticalStackLayout Padding="12" Spacing="8">
                <Label Text="{Binding Title}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding SubTitle, Converter={StaticResource Glyphs}}" Style="{StaticResource Secondary}" />
                <views:WheelView x:Name="Wheel" SemanticProperties.Description="The chart wheel. The planets are listed below it." />
                <Label Text="{Binding ScoreText}" TextColor="{Binding ScoreColorHex, Converter={StaticResource HexColor}}" FontAttributes="Bold" />
                <Label Text="{Binding BigThreeText, Converter={StaticResource Glyphs}}" Style="{StaticResource Body}" />
                <Label Text="{Binding AnglesText, Converter={StaticResource Glyphs}}" Style="{StaticResource Secondary}" />

                <Label Text="Planets" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" />
                <Label Text="Tap a planet to bring out its aspects on the wheel." Style="{StaticResource Secondary}" />
                <VerticalStackLayout x:Name="PlanetList" />

                <Label Text="Aspects" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" />
                <Label Text="{Binding AspectLines, Converter={StaticResource Glyphs}}" Style="{StaticResource Body}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
