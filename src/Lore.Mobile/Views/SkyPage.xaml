<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lore.ViewModels;assembly=Lore.Core"
             xmlns:models="clr-namespace:Lore.Models;assembly=Lore.Core"
             xmlns:views="clr-namespace:Lore.Mobile.Views"
             x:Class="Lore.Mobile.Views.SkyPage"
             x:DataType="vm:SkyViewModel"
             Title="Sky">
    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="8">
            <Label Text="The sky for everyone" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                <Button Text="‹" Command="{Binding PreviousDayCommand}" SemanticProperties.Description="Previous day" />
                <DatePicker Grid.Column="1" Date="{Binding PickerDate, Converter={StaticResource PickerDate}}" Format="ddd d MMM yyyy" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="›" Command="{Binding NextDayCommand}" SemanticProperties.Description="Next day" />
                <Button Grid.Column="3" Text="Today" Command="{Binding TodayCommand}" IsEnabled="{Binding IsToday, Converter={StaticResource Not}}" />
            </Grid>

            <!-- The week: a tone for each day; tap one to read it. -->
            <Grid x:Name="WeekStrip" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="2" BindableLayout.ItemsSource="{Binding Week}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SkyDayTone">
                        <Border Padding="0,6" StrokeThickness="0" BackgroundColor="{Binding ColorHex, Converter={StaticResource HexColor}}"
                                SemanticProperties.Description="{Binding AccessibleName}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDayTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding Weekday}" FontSize="12" FontAttributes="Bold" TextColor="#1C1B19" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DayText}" FontSize="11" TextColor="#1C1B19" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Label}" FontSize="9" TextColor="#1C1B19" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
            <Label Text="{Binding ErrorText}" Style="{StaticResource Error}" IsVisible="{Binding ErrorText, Converter={StaticResource HasText}}" />
            <Label Text="{Binding ToneText}" TextColor="{Binding ToneColorHex, Converter={StaticResource HexColor}}" FontAttributes="Bold" FontSize="17" />
            <views:WheelView x:Name="Wheel" SemanticProperties.Description="The day's sky: the planets at midday and the aspects between them." />
            <Label Text="{Binding WheelCaption, Converter={StaticResource Glyphs}}" Style="{StaticResource Secondary}" />
            <views:SectionsView Sections="{Binding Sections}" />
            <Button Text="{Binding TraceHeader}" Clicked="OnToggleTrace" HorizontalOptions="Start" Margin="0,16,0,0"
                    IsVisible="{Binding TraceHeader, Converter={StaticResource HasText}}" LineBreakMode="WordWrap" />
            <Label x:Name="TraceText" Text="{Binding Trace, Converter={StaticResource Glyphs}}" Style="{StaticResource Secondary}" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
