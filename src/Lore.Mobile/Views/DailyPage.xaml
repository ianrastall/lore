<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lore.ViewModels;assembly=Lore.Core"
             xmlns:views="clr-namespace:Lore.Mobile.Views"
             x:Class="Lore.Mobile.Views.DailyPage"
             x:DataType="vm:DailyViewModel"
             Title="Daily">
    <Grid>
        <Label Text="Choose someone in Charts to read their day." Style="{StaticResource Secondary}"
               HorizontalOptions="Center" VerticalOptions="Center" Padding="24" x:Name="NoChart" />
        <ScrollView x:Name="Body">
            <VerticalStackLayout Padding="12" Spacing="8">
                <Label Text="{Binding Title}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                    <Button Text="‹" Command="{Binding PreviousDayCommand}" SemanticProperties.Description="Previous day" />
                    <DatePicker Grid.Column="1" Date="{Binding PickerDate, Converter={StaticResource PickerDate}}" Format="ddd d MMM yyyy" HorizontalOptions="Center" />
                    <Button Grid.Column="2" Text="›" Command="{Binding NextDayCommand}" SemanticProperties.Description="Next day" />
                    <Button Grid.Column="3" Text="Today" Command="{Binding TodayCommand}" IsEnabled="{Binding IsToday, Converter={StaticResource Not}}" />
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                <Label Text="{Binding ErrorText}" Style="{StaticResource Error}" IsVisible="{Binding ErrorText, Converter={StaticResource HasText}}" />
                <Label Text="{Binding ToneText}" TextColor="{Binding ToneColorHex, Converter={StaticResource HexColor}}" FontAttributes="Bold" FontSize="17" />
                <views:WheelView x:Name="Wheel" SemanticProperties.Description="The birth chart in the middle, the day's sky around it." />
                <Label Text="{Binding WheelCaption, Converter={StaticResource Glyphs}}" Style="{StaticResource Secondary}" />
                <views:SectionsView Sections="{Binding Sections}" />
                <Button Text="{Binding TraceHeader}" Clicked="OnToggleTrace" HorizontalOptions="Start" Margin="0,16,0,0"
                        IsVisible="{Binding TraceHeader, Converter={StaticResource HasText}}" LineBreakMode="WordWrap" />
                <Label x:Name="TraceText" Text="{Binding Trace, Converter={StaticResource Glyphs}}" Style="{StaticResource Secondary}" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
