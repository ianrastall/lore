<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lore.ViewModels;assembly=Lore.Core"
             xmlns:models="clr-namespace:Lore.Models;assembly=Lore.Core"
             x:Class="Lore.Mobile.Views.ReportPage"
             x:DataType="vm:ChartViewModel"
             Title="Report">
    <Grid>
        <Label Text="Choose someone in Charts to read their chart." Style="{StaticResource Secondary}"
               HorizontalOptions="Center" VerticalOptions="Center" Padding="24"
               IsVisible="{Binding HasChart, Converter={StaticResource Not}}" />
        <ScrollView IsVisible="{Binding HasChart}">
            <VerticalStackLayout Padding="12" Spacing="4">
                <Label Text="{Binding Title}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReportSections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ReportSection">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Heading, Converter={StaticResource Glyphs}}" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Paragraphs}" Spacing="10">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding ., Converter={StaticResource Glyphs}}" Style="{StaticResource Body}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
