<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.LegendView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models">

    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedItems" IsSourceGrouped="True" />
    </UserControl.Resources>

    <!-- Every glyph, color and term in a list, and the explanation of the one selected -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="ItemsList"
                  ItemsSource="{x:Bind GroupedItems.View, Mode=OneWay}"
                  SelectionChanged="ItemsList_SelectionChanged"
                  Padding="0,0,0,12"
                  AutomationProperties.Name="Legend entries">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LegendItem">
                    <Grid ColumnSpacing="8" Padding="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Symbol}" Style="{StaticResource JupiterSectionHeadingTextStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource JupiterBodyTextStyle}" />
                            <TextBlock Text="{x:Bind Short}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}" Style="{StaticResource JupiterCaptionStrongTextStyle}" Margin="0,12,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <Border Grid.Column="1" Style="{StaticResource JupiterVerticalSeparatorStyle}" />

        <ScrollViewer Grid.Column="2" Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border x:Name="DetailSwatch" Width="4" Visibility="Collapsed" />
                    <TextBlock x:Name="DetailSymbol" Style="{StaticResource JupiterPageHeadingTextStyle}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="DetailName" Style="{StaticResource JupiterPageHeadingTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailGroup" Style="{StaticResource JupiterCaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="DetailContent" Spacing="12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
