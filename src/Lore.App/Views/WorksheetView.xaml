<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.WorksheetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models"
    xmlns:views="using:Lore.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="24" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.WorksheetTitle, Mode=OneWay}" Style="{StaticResource JupiterPageHeadingTextStyle}" />
                <TextBlock Text="The numbers behind the chart, and how they were arrived at. Nothing here is interpreted."
                           Style="{StaticResource JupiterCaptionTextStyle}" />
            </StackPanel>

            <!-- How this was calculated -->
            <StackPanel Spacing="8">
                <TextBlock Text="How this was calculated" Style="{StaticResource JupiterSectionHeadingTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Worksheet.Facts, Mode=OneWay, FallbackValue={x:Null}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WorksheetFact">
                            <Grid Padding="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="152" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource JupiterBodyTextStyle}" Foreground="{ThemeResource JupiterSecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap"
                                           MaxWidth="640" HorizontalAlignment="Left" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- What if the birth time is off? -->
            <StackPanel Spacing="8" Visibility="{x:Bind VisIf(ViewModel.HasChart), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.SensitivityHeading, Mode=OneWay}" Style="{StaticResource JupiterSectionHeadingTextStyle}" />
                <StackPanel Spacing="4" Visibility="{x:Bind VisIf(ViewModel.CanTestTime), Mode=OneWay}">
                    <views:NumberField x:Name="MarginBox" Header="Margin either way, in minutes (0 to 180)" Width="320" HorizontalAlignment="Left"
                                       Minimum="0" Maximum="180" ValueChanged="MarginBox_ValueChanged" />
                    <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                               Text="Recorded times are often rounded; set a margin to see what would change." />
                </StackPanel>
                <StackPanel Spacing="4" Visibility="{x:Bind VisIf(ViewModel.HasSensitivity), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.Sensitivity.Summary, Mode=OneWay, FallbackValue=''}" Style="{StaticResource JupiterBodyStrongTextStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.Sensitivity.Window, Mode=OneWay, FallbackValue=''}" Style="{StaticResource JupiterCaptionTextStyle}" />
                    <TextBlock Text="Depends on the time" Style="{StaticResource JupiterCaptionStrongTextStyle}" Margin="0,8,0,0"
                               Visibility="{x:Bind VisIf(ViewModel.SensitivityHasChanges), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sensitivity.Changes, Mode=OneWay, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" MaxWidth="790"
                                           HorizontalAlignment="Left" Padding="0,0,0,4" Foreground="{ThemeResource JupiterWarningBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Holds regardless" Style="{StaticResource JupiterCaptionStrongTextStyle}" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sensitivity.Holds, Mode=OneWay, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" MaxWidth="790"
                                           HorizontalAlignment="Left" Padding="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Positions -->
            <StackPanel Spacing="8">
                <TextBlock Text="Positions" Style="{StaticResource JupiterSectionHeadingTextStyle}" />
                <Grid Padding="0,0,0,4" BorderBrush="{ThemeResource JupiterSeparatorBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="Position" Style="{StaticResource JupiterCaptionStrongTextStyle}" />
                    <TextBlock Grid.Column="3" Text="Latitude" Style="{StaticResource JupiterCaptionStrongTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Declination" Style="{StaticResource JupiterCaptionStrongTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Speed per day" Style="{StaticResource JupiterCaptionStrongTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="House" Style="{StaticResource JupiterCaptionStrongTextStyle}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Worksheet.Positions, Mode=OneWay, FallbackValue={x:Null}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WorksheetRow">
                            <Grid Padding="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Symbol}" Style="{StaticResource JupiterBodyTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource JupiterBodyTextStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Position}" Style="{StaticResource JupiterBodyTextStyle}" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Latitude}" Style="{StaticResource JupiterBodyTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Declination}" Style="{StaticResource JupiterBodyTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Speed}" Style="{StaticResource JupiterBodyTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="{x:Bind House}" Style="{StaticResource JupiterBodyTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="{x:Bind Motion}" Style="{StaticResource JupiterBodyTextStyle}" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource JupiterSecondaryTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="790" HorizontalAlignment="Left"
                           Text="Latitude is measured from the ecliptic, declination from the celestial equator; + is north. A negative speed means the body is moving backwards through the zodiac: ℞ marks a planet that is retrograde, and S one that is stationary, standing nearly still as it turns (under about a tenth of its usual speed). The North Node and Lilith of the kind not chosen in Settings are given below the others for comparison; nothing else in Lore uses them." />
            </StackPanel>

            <!-- House cusps -->
            <StackPanel Spacing="8" Visibility="{x:Bind VisIf(ViewModel.WorksheetHasCusps), Mode=OneWay}">
                <TextBlock Text="House cusps" Style="{StaticResource JupiterSectionHeadingTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Worksheet.Cusps, Mode=OneWay, FallbackValue={x:Null}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="6" ItemWidth="260" ItemHeight="26" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WorksheetCusp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind House}" Style="{StaticResource JupiterBodyTextStyle}" Foreground="{ThemeResource JupiterSecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Position}" Style="{StaticResource JupiterBodyTextStyle}" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Aspect grid (built in code: one cell per pair of points) -->
            <StackPanel Spacing="8">
                <TextBlock Text="Aspects" Style="{StaticResource JupiterSectionHeadingTextStyle}" />
                <Grid x:Name="AspectGrid" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="790" HorizontalAlignment="Left"
                           Text="Each cell shows the aspect between the two points, how far it is from exact, and whether it is applying (a, closing) or separating (s, opening). A star marks an aspect that is out of sign: within orb by degree, but the two signs are not in that relationship (a conjunction from late Aries to early Taurus), which tradition reads as weaker. ☌ conjunction · ⚹ sextile · □ square · △ trine · ☍ opposition; and, when the minor aspects are switched on in Settings, ⚺ semi-sextile · ∠ semi-square · ⚼ sesquiquadrate · ⚻ quincunx." />
            </StackPanel>

            <!-- Further measurements (built in code: one small table per section) -->
            <StackPanel x:Name="SectionsPanel" Spacing="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
