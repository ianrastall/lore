<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models"
    xmlns:views="using:Lore.Views"
    xmlns:vm="using:Lore.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Whose, and what this is -->
        <StackPanel Padding="24,16,24,8" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource JupiterPageHeadingTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}"
                       TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
            <!-- Answers given here that have not reached the file -->
            <InfoBar Severity="Error" Title="Some answers are not saved" IsClosable="False"
                     Message="{x:Bind ViewModel.SaveProblem, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.HasSaveProblem, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Try again" Command="{x:Bind ViewModel.RetrySaveCommand}"
                            AutomationProperties.Name="Try again to save the answers" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Nobody selected -->
        <TextBlock Grid.Row="1" Margin="24,8,24,8" Style="{StaticResource JupiterBodyTextStyle}"
                   Text="Select one of your own charts from the Charts pane to answer the questionnaire for that person."
                   TextWrapping="Wrap"
                   Visibility="{x:Bind VisIf(ViewModel.IsNoChart), Mode=OneWay}" />

        <!-- A bundled figure -->
        <TextBlock Grid.Row="1" Margin="24,8,24,8" MaxWidth="720" HorizontalAlignment="Left" Style="{StaticResource JupiterBodyTextStyle}"
                   Text="{x:Bind ViewModel.NotOfferedText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind VisIf(ViewModel.IsNotOffered), Mode=OneWay}" />

        <!-- The questionnaire's own file is missing -->
        <TextBlock Grid.Row="1" Margin="24,8,24,8" MaxWidth="720" HorizontalAlignment="Left" Style="{StaticResource JupiterBodyTextStyle}"
                   Foreground="{ThemeResource JupiterErrorBrush}"
                   Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind VisIf(ViewModel.IsUnavailable), Mode=OneWay}" />

        <!-- Before beginning -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind VisIf(ViewModel.IsIntroduction), Mode=OneWay}">
            <StackPanel Spacing="12" Padding="24,8,24,24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind ViewModel.AboutText, Mode=OneWay}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.AstrologyText}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.PrivacyText}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="It should be answered by the person the chart belongs to, alone and without hurrying. There are no right answers."
                           Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" />
                <Button x:Name="BeginButton" Content="Begin" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.BeginCommand}"
                        AutomationProperties.Name="Begin the questionnaire" />
                <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Answering: a page of statements at a time -->
        <Grid Grid.Row="1" Visibility="{x:Bind VisIf(ViewModel.IsAsking), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="24,0,24,8" Spacing="8" MaxWidth="980" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind ViewModel.Prompt, Mode=OneWay}" Style="{StaticResource JupiterBodyTextStyle}"
                           Foreground="{ThemeResource JupiterSecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" Style="{StaticResource JupiterBodyTextStyle}"
                           Foreground="{ThemeResource JupiterWarningBrush}" TextWrapping="Wrap"
                           Visibility="{x:Bind VisIf(ViewModel.HasNotice), Mode=OneWay}" />
            </StackPanel>

            <ScrollViewer x:Name="QuestionScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,8">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Questions, Mode=OneWay}" MaxWidth="980" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InventoryQuestion">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind NumberText}" Style="{StaticResource JupiterBodyTextStyle}"
                                           Foreground="{ThemeResource JupiterSecondaryTextBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource JupiterBodyStrongTextStyle}" TextWrapping="Wrap" />
                                    <!-- Five choices in a row, least to most accurate -->
                                    <StackPanel Orientation="Horizontal" Spacing="16" AutomationProperties.Name="{x:Bind Text}">
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice1}" MinWidth="0" IsChecked="{x:Bind Is1, Mode=TwoWay}" />
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice2}" MinWidth="0" IsChecked="{x:Bind Is2, Mode=TwoWay}" />
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice3}" MinWidth="0" IsChecked="{x:Bind Is3, Mode=TwoWay}" />
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice4}" MinWidth="0" IsChecked="{x:Bind Is4, Mode=TwoWay}" />
                                        <RadioButton GroupName="{x:Bind GroupName}" Content="{x:Bind Choice5}" MinWidth="0" IsChecked="{x:Bind Is5, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="24,12,24,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource JupiterSeparatorBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Back" Command="{x:Bind ViewModel.PreviousCommand}"
                            IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                            AutomationProperties.Name="The ten statements before" />
                    <Button Content="Next" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.NextCommand}"
                            Visibility="{x:Bind VisIf(ViewModel.CanGoOn), Mode=OneWay}"
                            AutomationProperties.Name="The next ten statements" />
                    <Button Content="Finish and see the profile" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.FinishCommand}"
                            Visibility="{x:Bind VisIf(ViewModel.IsLastPage), Mode=OneWay}" />
                    <ProgressBar Width="224" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                 Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                 AutomationProperties.Name="How much of the questionnaire is answered" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource JupiterCaptionTextStyle}">
                        <Run Text="{x:Bind ViewModel.PageText, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                    </TextBlock>
                    <HyperlinkButton Content="Stop and discard this sitting" Click="Abandon_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- With a profile: the profile itself, or the reading that sets it beside the chart -->
        <Grid Grid.Row="1" Visibility="{x:Bind VisIf(ViewModel.IsProfile), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" Padding="24,0,24,8"
                        Visibility="{x:Bind VisIf(ViewModel.HasReading), Mode=OneWay}">
                <RadioButton Content="Profile" GroupName="InventoryMode"
                             AutomationProperties.Name="Show the personality profile"
                             IsChecked="{x:Bind Not(ViewModel.ShowReading), Mode=OneWay}"
                             Checked="ProfileRadio_Checked" />
                <RadioButton Content="Chart and answers" GroupName="InventoryMode"
                             AutomationProperties.Name="Show the reading that sets the profile beside the chart"
                             ToolTipService.ToolTip="How each planet of the chart is being lived, by the answers"
                             IsChecked="{x:Bind ViewModel.ShowReading, Mode=OneWay}"
                             Checked="ReadingRadio_Checked" />
                <Border Style="{StaticResource JupiterVerticalSeparatorStyle}" Margin="4,8,4,8" />
                <CheckBox Content="Let the answers shape the Report, Daily and Forecast"
                          IsChecked="{x:Bind ViewModel.ShapeReadings, Mode=TwoWay}"
                          ToolTipService.ToolTip="Adds sentences to the Report (its Overview, planets, aspects and balance) and to transits in the Daily and Forecast readings, saying how the answers describe what is spoken of. Each begins “By … answers”. The chart itself is never changed." />
            </StackPanel>

            <!-- The reading: chart and answers side by side -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind VisIf(ViewModel.ReadingShown), Mode=OneWay}">
                <views:ReadingList Sections="{x:Bind ViewModel.ReadingSections, Mode=OneWay}"
                                   Margin="24,0,24,24" MaxWidth="820" HorizontalAlignment="Left" />
            </ScrollViewer>

            <!-- The profile -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind VisIf(ViewModel.ProfileShown), Mode=OneWay}">
                <StackPanel Spacing="16" Padding="24,0,24,24" MaxWidth="1040" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Bind ViewModel.TakenText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Caution}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Domains, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DomainScore">
                                <StackPanel Spacing="8" Margin="0,8,0,16">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource JupiterSectionHeadingTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind BandLabel}" Style="{StaticResource JupiterBodyStrongTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource JupiterCaptionTextStyle}">
                                            <Run Text="{x:Bind ScoreText}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{x:Bind PercentileText}" />
                                        </TextBlock>
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Percentile}" Width="420" HorizontalAlignment="Left"
                                                 AutomationProperties.Name="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind About}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />

                                    <ItemsControl ItemsSource="{x:Bind Facets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:FacetScore">
                                                <Grid ColumnSpacing="12" Padding="0,4,0,4" ToolTipService.ToolTip="{x:Bind Measures}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="172" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource JupiterBodyStrongTextStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind BandLabel}" Style="{StaticResource JupiterBodyTextStyle}"
                                                               Foreground="{ThemeResource JupiterSecondaryTextBrush}" />
                                                    <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{x:Bind Percentile}"
                                                                 VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Text}" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                               Text="Low, typical and high are set against the reference group: typical is within one standard deviation of its average, where about two people in three fall; low and high are beyond that, about one in six each way. Each bar is an estimate of what share of that group scored lower. A facet rests on four statements, so read its bar as a rough placing and not as a measurement; the mood of the day moves some of them." />
                    <TextBlock Text="{x:Bind ViewModel.EstimateText}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.NormsText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Answer it again" Command="{x:Bind ViewModel.TakeAgainCommand}"
                                ToolTipService.ToolTip="A new sitting; this one is kept" />
                        <Button Content="Delete the answers…" Click="Delete_Click"
                                ToolTipService.ToolTip="Removes every answer saved for this person" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
