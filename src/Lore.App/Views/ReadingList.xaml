<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.ReadingList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models"
    xmlns:views="using:Lore.Views">

    <!-- The body of a written reading: every view that has one lays it out the same way. -->
    <ItemsControl ItemsSource="{x:Bind Sections, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:DailySection">
                <StackPanel Spacing="12" Margin="0,0,0,24">
                    <TextBlock Text="{x:Bind Heading}" Style="{StaticResource JupiterSectionHeadingTextStyle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DailyItem">
                                <StackPanel Spacing="4" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource JupiterBodyStrongTextStyle}"
                                               FontSize="{x:Bind views:ReadingText.Current.FontSize, Mode=OneWay}"
                                               LineHeight="{x:Bind views:ReadingText.Current.LineHeight, Mode=OneWay}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind HasTitle}" />
                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource JupiterCaptionTextStyle}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind HasMeta}" />
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource JupiterBodyTextStyle}"
                                               FontSize="{x:Bind views:ReadingText.Current.FontSize, Mode=OneWay}"
                                               LineHeight="{x:Bind views:ReadingText.Current.LineHeight, Mode=OneWay}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
