<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Lore.Views.WritersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lore.Models" xmlns:views="using:Lore.Views"
    SizeChanged="View_SizeChanged">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Padding="24,16,24,12" Spacing="12">
            <TextBlock Text="Writers" Style="{StaticResource JupiterPageHeadingTextStyle}" />
            <StackPanel x:Name="SearchForm" Spacing="12">
                <ComboBox x:Name="ModeBox" Header="Work with" SelectedIndex="0" SelectionChanged="Mode_Changed" HorizontalAlignment="Stretch" MaxWidth="480">
                    <ComboBoxItem Content="Create a character" /><ComboBoxItem Content="Find famous groups" /><ComboBoxItem Content="Saved briefs" />
                </ComboBox>
            <Expander x:Name="SearchOptions" Header="Search options" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="CharacterInputs" Spacing="12">
                        <AutoSuggestBox x:Name="PlaceBox" Header="Birthplace" PlaceholderText="Choose a city from the suggestions" QueryIcon="Find"
                            DisplayMemberPath="Display" TextMemberPath="Display" TextChanged="Place_TextChanged" QuerySubmitted="Place_QuerySubmitted"
                            SuggestionChosen="Place_Chosen" AutomationProperties.Name="Fictional birthplace" />
                        <TextBlock x:Name="PlaceNote" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Period starts" Style="{StaticResource JupiterFieldLabelTextStyle}" />
                                <CalendarDatePicker x:Name="StartPicker" HorizontalAlignment="Stretch" AutomationProperties.Name="Character period starts" />
                            </StackPanel>
                            <ComboBox x:Name="SpanBox" Grid.Column="1" Header="Search period" SelectedIndex="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="7 days" /><ComboBoxItem Content="30 days" /><ComboBoxItem Content="90 days" /><ComboBoxItem Content="366 days" />
                            </ComboBox>
                            <ComboBox x:Name="AnchorBox" Grid.Row="1" Header="Birth anchor" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Sky events" /><ComboBoxItem Content="Planet on Ascendant" /><ComboBoxItem Content="Planet on Midheaven" />
                                <ComboBoxItem Content="Chart patterns" /><ComboBoxItem Content="Sky event and angular planet (within 3°)" />
                            </ComboBox>
                            <ComboBox x:Name="PlanetBox" Grid.Row="1" Grid.Column="1" Header="Planet for angular anchors" SelectedIndex="3" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Sun" /><ComboBoxItem Content="Moon" /><ComboBoxItem Content="Mercury" /><ComboBoxItem Content="Venus" />
                                <ComboBoxItem Content="Mars" /><ComboBoxItem Content="Jupiter" /><ComboBoxItem Content="Saturn" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="GroupInputs" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ComboBox x:Name="SizeBox" Header="Group size" SelectedIndex="0" SelectionChanged="Size_Changed" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Pair" /><ComboBoxItem Content="Trio" />
                            </ComboBox>
                            <ComboBox x:Name="ToneBox" Grid.Column="1" Header="Relationship level" SelectedIndex="0" HorizontalAlignment="Stretch" />
                            <views:NumberField x:Name="DistanceBox" Grid.Row="1" Header="Maximum birthplace distance (km)" Minimum="1" Maximum="1000" />
                            <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" Header="Field (library category)" SelectedIndex="0"
                                ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" HorizontalAlignment="Stretch" />
                            <views:NumberField x:Name="FromYearBox" Grid.Row="2" Header="Births from year" Minimum="1200" Maximum="2400" />
                            <views:NumberField x:Name="ToYearBox" Grid.Row="2" Grid.Column="1" Header="Through year" Minimum="1200" Maximum="2400" />
                            <ComboBox x:Name="ProminenceBox" Grid.Row="3" Grid.ColumnSpan="2" Header="Prominence" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Whole library" /><ComboBoxItem Content="At least 10 Wikipedia editions and sister projects" />
                                <ComboBoxItem Content="At least 30 Wikipedia editions and sister projects" /><ComboBoxItem Content="At least 100 Wikipedia editions and sister projects" />
                            </ComboBox>
                        </Grid>
                        <TextBox x:Name="GroupSearchBox" Header="Every member must match" PlaceholderText="Name, birthplace, occupation or biography" />
                        <TextBlock Text="Every pair must meet the birthplace distance limit. The oldest and youngest must be within ten calendar years (29 February anniversaries use 28 February). Birthplaces do not establish that people met."
                            Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="SavedInputs" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Saved characters and casts are kept separately from My Charts and reopen exactly as written."
                            Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                        <Button Content="Reload saved briefs" Click="Reload_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="FindCharactersButton" Content="Find birth anchors" Style="{StaticResource AccentButtonStyle}" Click="FindCharacters_Click" />
                <Button x:Name="FindGroupsButton" Content="Find famous groups" Style="{StaticResource AccentButtonStyle}" Click="FindGroups_Click" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="HistoricalNote" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Padding="24,0,24,12" Spacing="8">
            <InfoBar Severity="Error" Title="Writers needs attention" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                IsOpen="{x:Bind HasText(ViewModel.Error), Mode=OneWay}" />
            <Grid x:Name="SearchStatus" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button Grid.Column="2" Content="Cancel search" Click="Cancel_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>
        </StackPanel>
        <Grid x:Name="ResultsGrid" Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ResultsColumn" Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid x:Name="ResultsPane" Background="{ThemeResource JupiterSurfaceBrush}">
                <ListView x:Name="CharactersList" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="Candidate_Click" AutomationProperties.Name="Birth anchors">
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:WriterCandidate"><StackPanel Spacing="4" Padding="8">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource JupiterBodyStrongTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <ListView x:Name="GroupsList" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="Group_Click" AutomationProperties.Name="Famous casts">
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:WriterGroup"><StackPanel Spacing="4" Padding="8">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource JupiterBodyStrongTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <ListView x:Name="SavedList" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Saved, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="Saved_Click" AutomationProperties.Name="Saved Writers briefs">
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:WriterBrief"><StackPanel Spacing="4" Padding="8">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource JupiterBodyStrongTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>
            <ScrollViewer x:Name="DetailPane" Grid.Column="1" Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Stretch">
                    <Button x:Name="BackButton" Content="Back to results" Click="Back_Click" Visibility="Collapsed" />
                    <TextBlock Text="Choose a birth anchor or a cast to read its brief." Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap"
                        Visibility="{x:Bind WhenEmpty(ViewModel.HasBrief), Mode=OneWay}" />
                    <StackPanel Spacing="12" Visibility="{x:Bind When(ViewModel.HasBrief), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.Brief.Title, Mode=OneWay}" Style="{StaticResource JupiterSectionHeadingTextStyle}" TextWrapping="Wrap" />
                        <Expander Header="Save, export or view chart" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                        <TextBox Header="Character or cast name" Text="{x:Bind ViewModel.BriefName, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save brief" Click="Save_Click" /><Button Content="Export text…" Tag="txt" Click="Export_Click" />
                            <Button Content="Export PDF…" Tag="pdf" Click="Export_Click" />
                        </StackPanel>
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" HorizontalAlignment="Left" />
                        <ComboBox x:Name="PreviewBox" Header="Underlying chart" HorizontalAlignment="Stretch" />
                        <Button Content="View chart" Click="Preview_Click" />
                        </StackPanel>
                        </Expander>
                        <views:ReadingList Sections="{x:Bind ViewModel.Sections, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
