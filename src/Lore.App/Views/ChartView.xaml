<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lore.Views.ChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:models="using:Lore.Models">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The wheel, under whose chart it is -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Padding="24,16,24,8" Spacing="4" Visibility="{x:Bind VisIf(ViewModel.HasChart), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource JupiterPageHeadingTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.SubTitle, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.BigThreeText, Mode=OneWay}" Style="{StaticResource JupiterBodyStrongTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.AnglesText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="12" Height="12" VerticalAlignment="Center" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{x:Bind BrushOf(ViewModel.ScoreColorHex), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" Style="{StaticResource JupiterBodyTextStyle}" />
                </StackPanel>
            </StackPanel>

            <canvas:CanvasControl x:Name="ChartCanvas" Grid.Row="1" Margin="16"
                                  Draw="ChartCanvas_Draw" SizeChanged="ChartCanvas_SizeChanged"
                                  AutomationProperties.Name="Chart wheel" />

            <!-- Nothing selected yet -->
            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind VisIfNot(ViewModel.HasChart), Mode=OneWay}">
                <TextBlock Text="No chart open" Style="{StaticResource JupiterPageHeadingTextStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Choose someone from the Charts pane, or use File > New chart (Ctrl+N)."
                           Style="{StaticResource JupiterBodyTextStyle}" Foreground="{ThemeResource JupiterSecondaryTextBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource JupiterVerticalSeparatorStyle}"
                Visibility="{x:Bind VisIf(ViewModel.HasChart), Mode=OneWay}" />

        <!-- Inspector: the planets and the aspects of the one selected -->
        <Grid Grid.Column="2" Width="320" Background="{ThemeResource JupiterSurfaceBrush}"
              Visibility="{x:Bind VisIf(ViewModel.HasChart), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <StackPanel Padding="16,16,16,8" Spacing="4">
                <TextBlock Text="Planets" Style="{StaticResource JupiterPaneHeadingTextStyle}" />
                <TextBlock Text="Select one to show its aspects." Style="{StaticResource JupiterCaptionTextStyle}" />
            </StackPanel>

            <ListView x:Name="PlanetsList" Grid.Row="1"
                      SelectionChanged="PlanetsList_SelectionChanged"
                      ItemsSource="{x:Bind ViewModel.Chart.Planets, Mode=OneWay, FallbackValue={x:Null}}"
                      AutomationProperties.Name="Planets">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlanetPosition">
                        <Grid ColumnSpacing="8" Padding="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind PlanetSymbol}" Style="{StaticResource JupiterSectionHeadingTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind PlanetName}" Style="{StaticResource JupiterBodyTextStyle}" />
                                <TextBlock Text="{x:Bind FormatPosition()}" Style="{StaticResource JupiterCaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="2" BorderBrush="{ThemeResource JupiterSeparatorBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,8">
                <TextBlock Text="Aspects" Style="{StaticResource JupiterPaneHeadingTextStyle}" />
            </Border>

            <ListView Grid.Row="3" SelectionMode="None"
                      ItemContainerStyle="{StaticResource JupiterCompactListViewItemStyle}"
                      ItemsSource="{x:Bind ViewModel.AspectLines, Mode=OneWay}"
                      AutomationProperties.Name="Aspects">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Style="{StaticResource JupiterBodyTextStyle}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
