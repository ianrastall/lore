<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Lore.Models"
    xmlns:views="using:Lore.Views"
    Title="Lore">

    <!-- Document workspace (standard section 7): the open chart is the document, with the
         Charts pane on the left and a status bar below. -->
    <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <views:HexBrushConverter x:Key="HexBrush" />
        </Grid.Resources>

        <MenuBar>
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New chart…" Click="NewChart_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Import My Charts…" Click="ImportMyCharts_Click" />
                <MenuFlyoutItem Text="Export My Charts…" Click="ExportMyCharts_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Export">
                    <MenuFlyoutSubItem Text="Chart">
                        <MenuFlyoutItem Text="Full reading as PDF…" Tag="pdf" Click="Export_Click" />
                        <MenuFlyoutItem Text="Chart image as PNG…" Tag="png" Click="Export_Click" />
                        <MenuFlyoutItem Text="Chart with tables as PNG…" Tag="sheetpng" Click="Export_Click" />
                        <MenuFlyoutItem Text="Chart data as JSON…" Tag="json" Click="Export_Click" />
                        <MenuFlyoutItem Text="Chart data as XML…" Tag="xml" Click="Export_Click" />
                        <MenuFlyoutItem Text="Worksheet as text…" Tag="worksheettxt" Click="Export_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Daily">
                        <MenuFlyoutItem Text="Daily horoscope as PDF…" Tag="dailypdf" Click="Export_Click" />
                        <MenuFlyoutItem Text="Daily horoscope as text…" Tag="dailytxt" Click="Export_Click" />
                        <MenuFlyoutItem Text="Transit wheel as PNG…" Tag="dailypng" Click="Export_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Forecast">
                        <MenuFlyoutItem Text="Forecast as PDF…" Tag="forecastpdf" Click="Export_Click" />
                        <MenuFlyoutItem Text="Forecast as text…" Tag="forecasttxt" Click="Export_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Timing">
                        <MenuFlyoutItem Text="Solar return and progressions as PDF…" Tag="timingpdf" Click="Export_Click" />
                        <MenuFlyoutItem Text="Solar return and progressions as text…" Tag="timingtxt" Click="Export_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Synastry">
                        <MenuFlyoutItem Text="Synastry reading as PDF…" Tag="synastrypdf" Click="Export_Click" />
                        <MenuFlyoutItem Text="Bi-wheel as PNG…" Tag="synastrypng" Click="Export_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Davison reading as PDF…" Tag="davisonpdf" Click="Export_Click" />
                        <MenuFlyoutItem Text="Davison wheel as PNG…" Tag="davisonpng" Click="Export_Click" />
                        <MenuFlyoutItem Text="Davison chart with tables as PNG…" Tag="davisonsheetpng" Click="Export_Click" />
                        <MenuFlyoutItem Text="Davison worksheet as text…" Tag="davisontxt" Click="Export_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Trine reading as PDF…" Tag="trinepdf" Click="Export_Click" />
                        <MenuFlyoutItem Text="Trine reading as text…" Tag="trinetxt" Click="Export_Click" />
                        <MenuFlyoutItem Text="Trine wheel as PNG…" Tag="trinepng" Click="Export_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Inventory">
                        <MenuFlyoutItem Text="Personality profile as text…" Tag="inventorytxt" Click="Export_Click" />
                        <MenuFlyoutItem Text="Character as text…" Tag="charactertxt" Click="Export_Click" />
                        <MenuFlyoutItem Text="Chart and answers as text…" Tag="mirrortxt" Click="Export_Click" />
                    </MenuFlyoutSubItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Settings" Click="Settings_Click" KeyboardAcceleratorTextOverride="Ctrl+," />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" KeyboardAcceleratorTextOverride="Alt+F4" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Find…" Click="Find_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="ChartsPaneItem" Text="Charts pane" Click="ChartsPane_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="B" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Chart" Tag="Chart" Click="ViewMenu_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number1" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Report" Tag="Report" Click="ViewMenu_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number2" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Worksheet" Tag="Worksheet" Click="ViewMenu_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number3" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Daily" Tag="Daily" Click="ViewMenu_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number4" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Forecast" Tag="Forecast" Click="ViewMenu_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number5" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Timing" Tag="Timing" Click="ViewMenu_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number6" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Synastry" Tag="Synastry" Click="ViewMenu_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number7" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Inventory" Tag="Inventory" Click="ViewMenu_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number8" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Larger reading text" Click="ReadingLarger_Click" KeyboardAcceleratorTextOverride="Ctrl++" />
                <MenuFlyoutItem Text="Smaller reading text" Click="ReadingSmaller_Click" KeyboardAcceleratorTextOverride="Ctrl+-" />
                <MenuFlyoutItem Text="Default reading text" Click="ReadingDefault_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Full screen" Click="FullScreen_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F11" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Chart">
                <MenuFlyoutItem Text="Edit chart…" Click="EditChart_Click" IsEnabled="{x:Bind ViewModel.SelectedIsCustom, Mode=OneWay}" />
                <MenuFlyoutItem Text="Delete chart…" Click="DeleteChart_Click" IsEnabled="{x:Bind ViewModel.SelectedIsCustom, Mode=OneWay}" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Legend" Click="Legend_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About Lore" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChartsColumn" Width="320" MinWidth="240" MaxWidth="800" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Charts pane: the figure library and the reader's own charts -->
            <Grid x:Name="ChartsPane" Background="{ThemeResource JupiterSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,8,8,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Charts" Style="{StaticResource JupiterPaneHeadingTextStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource JupiterSubtleButtonStyle}" Click="NewChart_Click"
                            AutomationProperties.Name="New chart" ToolTipService.ToolTip="New chart (Ctrl+N)">
                        <FontIcon Glyph="&#xE710;" Style="{StaticResource JupiterCommandIconStyle}" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource JupiterSubtleButtonStyle}" Click="EditChart_Click"
                            IsEnabled="{x:Bind ViewModel.SelectedIsCustom, Mode=OneWay}"
                            AutomationProperties.Name="Edit chart" ToolTipService.ToolTip="Edit chart">
                        <FontIcon Glyph="&#xE70F;" Style="{StaticResource JupiterCommandIconStyle}" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource JupiterSubtleButtonStyle}" Click="DeleteChart_Click"
                            IsEnabled="{x:Bind ViewModel.SelectedIsCustom, Mode=OneWay}"
                            AutomationProperties.Name="Delete chart" ToolTipService.ToolTip="Delete chart">
                        <FontIcon Glyph="&#xE74D;" Style="{StaticResource JupiterCommandIconStyle}" />
                    </Button>
                </Grid>

                <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Margin="16,0,16,8" QueryIcon="Find"
                                PlaceholderText="Search by name or place"
                                TextChanged="SearchBox_TextChanged"
                                AutomationProperties.Name="Search charts" />

                <ComboBox x:Name="CategoryCombo" Grid.Row="2" Margin="16,0,16,8" HorizontalAlignment="Stretch"
                          PlaceholderText="All categories"
                          ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                          AutomationProperties.Name="Category" />

                <ListView x:Name="CelebrityList" Grid.Row="3"
                          ItemsSource="{x:Bind ViewModel.DisplayedCelebrities, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedCelebrity, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Celebrity">
                            <Grid ColumnSpacing="8" Padding="0,4,0,4" ToolTipService.ToolTip="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource JupiterBodyTextStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind Category}" />
                                        <Run Text="·" />
                                        <Run Text="{x:Bind BirthDate}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- The dignity verdict: empty for an ordinary chart, a mark for a notable one -->
                                <Border Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Background="{Binding VerdictColorHex, Converter={StaticResource HexBrush}}"
                                        ToolTipService.ToolTip="{x:Bind VerdictLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:GridSplitter x:Name="ChartsSplitter" Grid.Column="1" Width="8" ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns"
                                   Background="{ThemeResource JupiterWindowBrush}" AutomationProperties.Name="Resize Charts pane" />

            <!-- The open chart: its views, and the one on show -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <SelectorBar x:Name="ViewBar" SelectionChanged="ViewBar_SelectionChanged">
                    <SelectorBarItem Text="Chart" Tag="Chart" IsSelected="True" ToolTipService.ToolTip="The chart wheel (Ctrl+1)" />
                    <SelectorBarItem Text="Report" Tag="Report" ToolTipService.ToolTip="A written reading of the chart (Ctrl+2)" />
                    <SelectorBarItem Text="Worksheet" Tag="Worksheet" ToolTipService.ToolTip="The numbers behind the chart, and how they were calculated (Ctrl+3)" />
                    <SelectorBarItem Text="Daily" Tag="Daily" ToolTipService.ToolTip="Daily horoscope from the day's transits (Ctrl+4)" />
                    <SelectorBarItem Text="Forecast" Tag="Forecast" ToolTipService.ToolTip="The transits coming up over the next weeks and months (Ctrl+5)" />
                    <SelectorBarItem Text="Timing" Tag="Timing" ToolTipService.ToolTip="The solar return for the year, and the chart progressed to a date (Ctrl+6)" />
                    <SelectorBarItem Text="Synastry" Tag="Synastry" ToolTipService.ToolTip="Compare this chart with another person's (Ctrl+7)" />
                    <SelectorBarItem Text="Inventory" Tag="Inventory" ToolTipService.ToolTip="Personality, character and life-area questionnaires for one of your own charts, and what they do to its readings (Ctrl+8)" />
                    <SelectorBarItem Text="Legend" Tag="Legend" ToolTipService.ToolTip="What every symbol, color and term means (F1)" />
                </SelectorBar>

                <!-- A problem that needs reading: a file set aside, a copy with a file missing -->
                <InfoBar Grid.Row="1" Severity="Warning" Title="Lore needs attention"
                         Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                         IsOpen="{x:Bind HasNotice(ViewModel.Notice), Mode=OneWay}"
                         CloseButtonClick="Notice_CloseButtonClick" />

                <Grid Grid.Row="2">
                    <views:ChartView x:Name="ChartViewControl" ViewModel="{x:Bind ViewModel.ChartVM}" />
                    <views:ReportView x:Name="ReportViewControl" ViewModel="{x:Bind ViewModel.ChartVM}" Visibility="Collapsed" />
                    <views:WorksheetView x:Name="WorksheetViewControl" ViewModel="{x:Bind ViewModel.ChartVM}" Visibility="Collapsed" />
                    <views:DailyView x:Name="DailyViewControl" ViewModel="{x:Bind ViewModel.DailyVM}" Visibility="Collapsed" />
                    <views:ForecastView x:Name="ForecastViewControl" ViewModel="{x:Bind ViewModel.ForecastVM}" Visibility="Collapsed" />
                    <views:TimingView x:Name="TimingViewControl" ViewModel="{x:Bind ViewModel.TimingVM}" Visibility="Collapsed" />
                    <views:SynastryView x:Name="SynastryViewControl" ViewModel="{x:Bind ViewModel.SynastryVM}" Visibility="Collapsed" />
                    <views:InventoryView x:Name="InventoryViewControl" ViewModel="{x:Bind ViewModel.InventoryVM}" Visibility="Collapsed" />
                    <views:LegendView x:Name="LegendViewControl" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource JupiterStatusBarStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" />
            </Grid>
        </Border>
    </Grid>
</Window>
