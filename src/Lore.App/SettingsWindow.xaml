<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lore.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:jupiter="using:Jupiter.UI"
    xmlns:views="using:Lore.Views"
    Title="Settings - Lore">

    <!-- Standard section 11: one scrolling column, changes apply at once. -->
    <ScrollViewer x:Name="Root" Background="{ThemeResource JupiterWindowBrush}" RequestedTheme="Dark">
        <StackPanel Padding="24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource JupiterPageHeadingTextStyle}" />

            <TextBlock Text="Appearance" Style="{StaticResource JupiterSectionHeadingTextStyle}" Margin="0,24,0,12" />
            <jupiter:AccentColorSetting x:Name="AccentControl" />

            <TextBlock Text="Calculation" Style="{StaticResource JupiterSectionHeadingTextStyle}" Margin="0,32,0,12" />
            <StackPanel Spacing="16">
                <ComboBox x:Name="HouseSystemCombo" Header="House system" MinWidth="240" SelectionChanged="Settings_Changed">
                    <ComboBoxItem Content="Placidus" />
                    <ComboBoxItem Content="Whole Sign" />
                    <ComboBoxItem Content="Equal" />
                    <ComboBoxItem Content="Koch" />
                </ComboBox>
                <ComboBox x:Name="NodeTypeCombo" Header="North Node" MinWidth="240" SelectionChanged="Settings_Changed">
                    <ComboBoxItem Content="Mean node" />
                    <ComboBoxItem Content="True node" />
                </ComboBox>
                <StackPanel Spacing="4">
                    <ComboBox x:Name="LilithTypeCombo" Header="Black Moon Lilith" MinWidth="240" SelectionChanged="Settings_Changed">
                        <ComboBoxItem Content="Mean Lilith" />
                        <ComboBoxItem Content="True (osculating) Lilith" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"
                               Text="House system, node and Lilith apply to every chart, the daily horoscope and synastry. Each chart shows which settings were used." />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Aspect orbs" Style="{StaticResource JupiterSectionHeadingTextStyle}" Margin="0,32,0,12" />
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <ComboBox x:Name="OrbPresetCombo" Header="Orbs in a birth chart" MinWidth="320" SelectionChanged="OrbPreset_Changed">
                        <ComboBoxItem Content="Standard: 8°, sextile 6°" />
                        <ComboBoxItem Content="Tight: 6°, sextile 4°, Sun and Moon +2°" />
                        <ComboBoxItem Content="Wide: 10°, sextile 6°" />
                        <ComboBoxItem Content="Custom" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"
                               Text="The orbs apply to aspects within a birth chart. Synastry (6°) and the daily horoscope (1°) keep their own." />
                </StackPanel>
                <Grid ColumnSpacing="16" RowSpacing="16" MaxWidth="400" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <views:NumberField x:Name="OrbConjunctionBox" Header="☌ Conjunction" Minimum="0" Maximum="15" ValueChanged="Orb_Changed" />
                    <views:NumberField x:Name="OrbOppositionBox" Grid.Column="1" Header="☍ Opposition" Minimum="0" Maximum="15" ValueChanged="Orb_Changed" />
                    <views:NumberField x:Name="OrbSquareBox" Grid.Row="1" Header="□ Square" Minimum="0" Maximum="15" ValueChanged="Orb_Changed" />
                    <views:NumberField x:Name="OrbTrineBox" Grid.Row="1" Grid.Column="1" Header="△ Trine" Minimum="0" Maximum="15" ValueChanged="Orb_Changed" />
                    <views:NumberField x:Name="OrbSextileBox" Grid.Row="2" Header="⚹ Sextile" Minimum="0" Maximum="15" ValueChanged="Orb_Changed" />
                    <views:NumberField x:Name="OrbLuminaryBox" Grid.Row="2" Grid.Column="1" Header="Extra for Sun and Moon" Minimum="0" Maximum="15" ValueChanged="Orb_Changed" />
                </Grid>
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="MinorAspectsToggle" Header="Minor aspects" Toggled="Minor_Toggled" />
                    <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"
                               Text="Also finds the semi-sextile (30°), semi-square (45°), quintile (72°), sesquiquadrate (135°), biquintile (144°) and quincunx (150°), and the Yod pattern." />
                </StackPanel>
                <views:NumberField x:Name="OrbMinorBox" Header="Minor aspect orb" Minimum="0" Maximum="15" Width="192" HorizontalAlignment="Left" ValueChanged="Orb_Changed" />
            </StackPanel>

            <TextBlock Text="Where you are" Style="{StaticResource JupiterSectionHeadingTextStyle}" Margin="0,32,0,12" />
            <StackPanel Spacing="4">
                <AutoSuggestBox x:Name="HomeBox" Header="City"
                                PlaceholderText="Search for your city…"
                                QueryIcon="Find"
                                DisplayMemberPath="Display"
                                TextMemberPath="Display"
                                TextChanged="HomeBox_TextChanged"
                                QuerySubmitted="HomeBox_QuerySubmitted"
                                AutomationProperties.Name="Where you are" />
                <TextBlock x:Name="HomeText" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"
                           Text="Used only for sunrise, sunset and the planetary hours in the Daily view. It is kept on this PC and changes nothing about any chart." />
                <Button x:Name="HomeClearButton" Content="Clear" Margin="0,4,0,0" Click="HomeClear_Click"
                        AutomationProperties.Name="Clear where you are" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
